e_settings></tab_browse><tab_sql><sql name="SQL 1">CREATE TABLE cursos_usuario (
  id_curso_usuario SERIAL PRIMARY KEY,
  user_id BIGINT REFERENCES users(id) NOT NULL,
  curso_id BIGINT REFERENCES cursos(id_curso) NOT NULL,
  estado VARCHAR(20) NOT NULL, -- INICIADO | COMPLETADO
  fecha_estado TIMESTAMP
);

